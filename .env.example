# Entorno
NODE_ENV=development
PORT=5000
# Origen del front permitido por CORS (además de https://niv0web.vercel.app)
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT (mínimo 32 caracteres cada uno, distintos entre sí)
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32-chars

# Backblaze B2
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_ID=your-b2-bucket-id
B2_BUCKET_NAME=your-b2-bucket-name
# Base pública sin el bucket: la API arma <B2_PUBLIC_URL>/<B2_BUCKET_NAME>/<key>
B2_PUBLIC_URL=https://s3.us-east-005.backblazeb2.com

# Google OAuth (el mismo client id que usa el front)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
