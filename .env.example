# Entorno
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT (minimo 32 caracteres cada uno)
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32-chars

# Backblaze B2
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_ID=your-b2-bucket-id
B2_BUCKET_NAME=your-b2-bucket-name
B2_PUBLIC_URL=https://f000.backblazeb2.com/file/your-bucket-name

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
